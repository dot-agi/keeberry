{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keeberry",
  "version": "0.1.0",
  "identifier": "app.keeberry.configurator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "keeberry configurator",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/wb32-dfu-updater_cli"],
    "resources": ["resources/keeberry.bin", "resources/firmware.json"]
  }
}
