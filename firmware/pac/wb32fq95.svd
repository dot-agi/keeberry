    <peripheral>
      <name>CACHE</name>
      <description>Flash cache control (holds the flash wait-state configuration)</description>
      <baseAddress>0x40015400</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
