          <name>CR</name>
          <description>Cache control register</description>
          <addressOffset>0x00</addressOffset>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>SFM</name>
      <description>Special function macro. Also holds the USB PHY port control registers (USBPCON enables the USB transceiver).</description>
      <baseAddress>0x40014C00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control register</description>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <name>DATA</name>
          <description>Input data register</description>
          <addressOffset>0x04</addressOffset>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <name>DOUT[%s]</name>
          <description>Result register</description>
          <addressOffset>0x08</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>USBPCON</name>
          <description>USB port control register</description>
          <addressOffset>0x40</addressOffset>
        </register>
        <register>
          <name>USBPSDCSR</name>
          <description>USB port state detect control/status register</description>
          <addressOffset>0x44</addressOffset>
        </register>
        <register>
          <name>USBPSTAT</name>
          <description>USB port status register</description>
          <addressOffset>0x48</addressOffset>
          <access>read-only</access>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>TIM1</name>
      <description>Advanced-control timer</description>
      <baseAddress>0x40001C00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
