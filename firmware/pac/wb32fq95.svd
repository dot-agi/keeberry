<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Westberry</vendor>
  <name>WB32FQ95</name>
  <version>0.1</version>
  <description>Westberry WB32FQ95 (ARM Cortex-M3)</description>
  <cpu>
    <name>CM3</name>
    <revision>r2p1</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>4</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>

    <peripheral>
      <name>GPIOA</name>
      <description>General-purpose I/O port A</description>
      <baseAddress>0x40000000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MODER</name>
          <description>Port mode register</description>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <name>OTYPER</name>
          <description>Port output type register</description>
          <addressOffset>0x04</addressOffset>
        </register>
        <register>
          <name>OSPEEDR</name>
          <description>Port output speed register</description>
          <addressOffset>0x08</addressOffset>
        </register>
        <register>
          <name>PUPDR</name>
          <description>Port pull-up/pull-down register</description>
          <addressOffset>0x0C</addressOffset>
        </register>
        <register>
          <name>IDR</name>
          <description>Port input data register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ODR</name>
          <description>Port output data register</description>
          <addressOffset>0x14</addressOffset>
        </register>
        <register>
          <name>BSRR</name>
          <description>Port bit set/reset register</description>
          <addressOffset>0x18</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>LCKR</name>
          <description>Port configuration lock register</description>
          <addressOffset>0x1C</addressOffset>
        </register>
        <register>
          <name>AFRL</name>
          <description>Alternate function low register</description>
          <addressOffset>0x20</addressOffset>
        </register>
        <register>
          <name>AFRH</name>
          <description>Alternate function high register</description>
          <addressOffset>0x24</addressOffset>
        </register>
        <register>
          <name>SMIT</name>
          <description>Port Schmitt-trigger input configuration register (vendor extension)</description>
          <addressOffset>0x28</addressOffset>
        </register>
        <register>
          <name>CURRENT</name>
          <description>Port drive-current configuration register (vendor extension)</description>
          <addressOffset>0x2C</addressOffset>
        </register>
        <register>
          <name>CFGMSK</name>
          <description>Port per-pin configuration write-mask register (vendor extension)</description>
          <addressOffset>0x30</addressOffset>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="GPIOA">
      <name>GPIOB</name>
      <description>General-purpose I/O port B</description>
      <baseAddress>0x40000400</baseAddress>
    </peripheral>

    <peripheral derivedFrom="GPIOA">
      <name>GPIOC</name>
      <description>General-purpose I/O port C</description>
      <baseAddress>0x40000800</baseAddress>
    </peripheral>

    <peripheral derivedFrom="GPIOA">
      <name>GPIOD</name>
      <description>General-purpose I/O port D</description>
      <baseAddress>0x40000C00</baseAddress>
    </peripheral>

    <peripheral>
      <name>PWR</name>
      <description>Power control. ANAKEY1/ANAKEY2 unlock write access to the ANCTL block.</description>
      <baseAddress>0x40010000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CR0</name>
          <description>Control register 0</description>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <name>CR1</name>
          <description>Control register 1</description>
          <addressOffset>0x04</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>CR2</name>
          <description>Control register 2</description>
          <addressOffset>0x08</addressOffset>
        </register>
        <register>
          <name>SR0</name>
          <description>Status register 0</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>SR1</name>
          <description>Status register 1</description>
          <addressOffset>0x14</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>GPREG0</name>
          <description>General-purpose register 0</description>
          <addressOffset>0x18</addressOffset>
        </register>
        <register>
          <name>GPREG1</name>
          <description>General-purpose register 1</description>
          <addressOffset>0x1C</addressOffset>
        </register>
        <register>
          <name>CFGR</name>
          <description>Configuration register</description>
          <addressOffset>0x20</addressOffset>
        </register>
        <register>
          <name>ANAKEY1</name>
          <description>ANCTL write-enable key register 1</description>
          <addressOffset>0x28</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>ANAKEY2</name>
          <description>ANCTL write-enable key register 2</description>
          <addressOffset>0x2C</addressOffset>
          <access>write-only</access>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>ANCTL</name>
      <description>Analog control block (holds HSE and PLL control). Write access is gated by PWR.ANAKEY1/ANAKEY2.</description>
      <baseAddress>0x40010400</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>BGCR2</name>
          <description>Bandgap control register 2</description>
          <addressOffset>0x1C</addressOffset>
        </register>
        <register>
          <name>MHSIENR</name>
          <description>MHSI oscillator enable register</description>
          <addressOffset>0x2C</addressOffset>
        </register>
        <register>
          <name>MHSISR</name>
          <description>MHSI oscillator status register</description>
          <addressOffset>0x30</addressOffset>
        </register>
        <register>
          <name>FHSIENR</name>
          <description>FHSI oscillator enable register</description>
          <addressOffset>0x38</addressOffset>
        </register>
        <register>
          <name>FHSISR</name>
          <description>FHSI oscillator status register</description>
          <addressOffset>0x3C</addressOffset>
        </register>
        <register>
          <name>LSIENR</name>
          <description>LSI oscillator enable register</description>
          <addressOffset>0x44</addressOffset>
        </register>
        <register>
          <name>LSISR</name>
          <description>LSI oscillator status register</description>
          <addressOffset>0x48</addressOffset>
        </register>
        <register>
          <name>HSECR0</name>
          <description>HSE control register 0</description>
          <addressOffset>0x4C</addressOffset>
        </register>
        <register>
          <name>HSECR1</name>
          <description>HSE control register 1</description>
          <addressOffset>0x50</addressOffset>
        </register>
        <register>
          <name>HSESR</name>
          <description>HSE status register</description>
          <addressOffset>0x58</addressOffset>
        </register>
        <register>
          <name>PLLCR</name>
          <description>PLL control register</description>
          <addressOffset>0x74</addressOffset>
        </register>
        <register>
          <name>PLLENR</name>
          <description>PLL enable register</description>
          <addressOffset>0x78</addressOffset>
        </register>
        <register>
          <name>PLLSR</name>
          <description>PLL status register</description>
          <addressOffset>0x7C</addressOffset>
        </register>
        <register>
          <name>PVDCR</name>
          <description>Programmable voltage detector control register</description>
          <addressOffset>0x80</addressOffset>
        </register>
        <register>
          <name>PVDENR</name>
          <description>Programmable voltage detector enable register</description>
          <addressOffset>0x84</addressOffset>
        </register>
        <register>
          <name>SARENR</name>
          <description>SAR ADC enable register</description>
          <addressOffset>0x8C</addressOffset>
        </register>
        <register>
          <name>USBPCR</name>
          <description>USB PHY control register</description>
          <addressOffset>0x90</addressOffset>
        </register>
        <register>
          <name>PORCR</name>
          <description>Power-on reset control register</description>
          <addressOffset>0x94</addressOffset>
        </register>
        <register>
          <name>CMPACR</name>
          <description>Comparator A control register</description>
          <addressOffset>0x98</addressOffset>
        </register>
        <register>
          <name>CMPBCR</name>
          <description>Comparator B control register</description>
          <addressOffset>0x9C</addressOffset>
        </register>
        <register>
          <name>ISR</name>
          <description>Interrupt status register</description>
          <addressOffset>0xA0</addressOffset>
        </register>
        <register>
          <name>IER</name>
          <description>Interrupt enable register</description>
          <addressOffset>0xA4</addressOffset>
        </register>
        <register>
          <name>ICR</name>
          <description>Interrupt clear register</description>
          <addressOffset>0xA8</addressOffset>
        </register>
        <register>
          <name>CMPASR</name>
          <description>Comparator A status register</description>
          <addressOffset>0xAC</addressOffset>
        </register>
        <register>
          <name>CMPBSR</name>
          <description>Comparator B status register</description>
          <addressOffset>0xB0</addressOffset>
        </register>
        <register>
          <name>DCSSENR</name>
          <description>Clock security system enable register</description>
          <addressOffset>0xB4</addressOffset>
        </register>
        <register>
          <name>DCSSCR</name>
          <description>Clock security system control register</description>
          <addressOffset>0xB8</addressOffset>
        </register>
      </registers>
    </peripheral>

